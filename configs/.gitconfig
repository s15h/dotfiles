[user]
	email = sietze@s15h.nl
	name = Sietze van den Bergh
[include]
	path = ~/.config/git/signingkey.gitconfig
[pull]
	rebase = true
[commit]
	gpgsign = true
[fetch]
	prune = true
[init]
	defaultBranch = main
[branch]
	sort = -committerdate
[log]
	date = iso
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
	autoUpdate = true
[includeIf "gitdir/i:~/project/dignitas/"]
	path = ~/project/dignitas/.gitconfig
[core]
	autocrlf = input
[color]
	ui = auto
